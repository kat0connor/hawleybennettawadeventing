  h1.hero-name{font-family:var(--serif); font-weight:600; font-size:clamp(3rem, 9vw, 6.4rem); line-height:0.95; letter-spacing:-0.01em; max-width:14ch;}
  .hero-tagline{font-family:var(--serif); font-style:italic; font-weight:400; font-size:clamp(1.1rem, 2.4vw, 1.5rem); color:rgba(255,255,255,0.85); margin-top:22px; max-width:42ch;}
  .hero-stats{margin-top:56px; display:grid; grid-template-columns:repeat(4,auto); gap:0 44px; border-top:1px solid rgba(255,255,255,0.22); padding-top:28px; max-width:760px;}
  .stat-num{font-family:var(--serif); font-size:1.9rem; font-weight:600; color:var(--canvas);}
  .stat-label{font-family:var(--mono); font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase; color:rgba(255,255,255,0.6); margin-top:4px;}
  @media (max-width:760px){ .hero-stats{grid-template-columns:1fr 1fr; row-gap:24px;} }

  .cta-row{margin-top:48px; display:flex; gap:16px; flex-wrap:wrap;}
  .btn{font-family:var(--mono); font-size:0.72rem; letter-spacing:0.08em; text-transform:uppercase; padding:14px 26px; border-radius:2px; border:1px solid transparent; transition:transform .2s ease, background .2s ease, color .2s ease; display:inline-block;}
  .btn-solid{background:var(--red); color:var(--canvas);}
  .btn-solid:hover{transform:translateY(-2px); background:#7a0d02;}
  .btn-outline{border-color:rgba(255,255,255,0.4); color:var(--canvas);}
  .btn-outline:hover{transform:translateY(-2px); border-color:var(--canvas);}

  /* SECTION SHELL */
  section{padding:110px 0;}
  .section-head{margin-bottom:56px; max-width:640px;}
  .section-eyebrow{font-family:var(--mono); font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--red); margin-bottom:14px;}
  h2{font-family:var(--serif); font-weight:600; font-size:clamp(2rem,4.4vw,3rem); letter-spacing:-0.01em;}
  .section-sub{font-family:var(--serif); font-style:italic; color:rgba(56,77,102,0.65); margin-top:14px; font-size:1.05rem;}

