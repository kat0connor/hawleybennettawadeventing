(function () {
  var monthMap = { Jan:0, Feb:1, Mar:2, Apr:3, May:4, Jun:5, Jul:6, Aug:7, Sep:8, Oct:9, Nov:10, Dec:11 };
  function parseEndDate(card) {
    var explicit = card.getAttribute('data-end');
    if (explicit) {
      var parts = explicit.split('-');
      return new Date(parseInt(parts[0],10), parseInt(parts[1],10)-1, parseInt(parts[2],10));
    }
    var dateEl = card.querySelector('.clinic-date');
    if (!dateEl) return null;
    var m = dateEl.textContent.trim().match(/^([A-Za-z]{3})\s+(\d{1,2})[\u2013-](\d{1,2})$/);
    if (!m) return null;
    var mon = m[1], endDay = parseInt(m[3], 10);
    var now = new Date();
    var monthIdx = monthMap[mon];
    var year = now.getFullYear();
    var candidate = new Date(year, monthIdx, endDay);
    if (candidate < new Date(now.getFullYear(), now.getMonth() - 2, now.getDate())) {
      candidate = new Date(year + 1, monthIdx, endDay);
    }
    return candidate;
  }
  function hidePastClinics() {
    var today = new Date();
    var todayMidnight = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    var cards = document.querySelectorAll('.clinic-list .clinic-card');
    cards.forEach(function (card) {
      var endDate = parseEndDate(card);
      if (endDate && endDate < todayMidnight) {
        card.style.display = 'none';
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hidePastClinics);
  } else {
    hidePastClinics();
  }
})();
</script></body></html>
