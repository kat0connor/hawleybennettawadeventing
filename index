  @media (max-width:760px){ .highlights{grid-template-columns:repeat(2,1fr);} }
  .highlight-cell{background:var(--canvas); padding:32px 22px; text-align:center;}
  .highlight-num{font-family:var(--serif); font-weight:600; font-size:2.6rem; color:var(--red); line-height:1;}
  .highlight-label{font-family:var(--mono); font-size:0.64rem; letter-spacing:0.06em; text-transform:uppercase; color:rgba(56,77,102,0.7); margin-top:10px;}

  /* SPONSORS */
